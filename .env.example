# =============================================================================
# MAGNA — Variables de Entorno
# =============================================================================
# Copia este archivo como .env y completa los valores.

# --- Django ------------------------------------------------------------------
SECRET_KEY=genera-una-clave-segura-con: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_ENV=production              # development | production
DJANGO_DEBUG=False
ALLOWED_HOSTS=magnaingenieriaytopografia.com,www.magnaingenieriaytopografia.com
DOMAIN=magnaingenieriaytopografia.com

# --- Base de Datos (PostgreSQL) ----------------------------------------------
DB_PASSWORD=genera-un-password-seguro-aqui

# --- Docker Hub (para deploy) ------------------------------------------------
# Opcional — si se omite, la imagen se construye directamente en la instancia
DOCKERHUB_USER=tu-usuario-dockerhub
DOCKERHUB_TOKEN=tu-token-dockerhub
IMAGE_TAG=latest

# --- CORS / CSRF -------------------------------------------------------------
CORS_ORIGIN_WHITELIST=https://magnaingenieriaytopografia.com,https://www.magnaingenieriaytopografia.com
CSRF_TRUSTED_ORIGINS=https://magnaingenieriaytopografia.com,https://www.magnaingenieriaytopografia.com

# --- Email SMTP --------------------------------------------------------------
# Si se omite, los correos se imprimen en consola
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=infoventas8080@gmail.com
EMAIL_HOST_PASSWORD=dznc ihuf imaf jqcg

# --- Contacto / Notificaciones -----------------------------------------------
# Correo que recibe las notificaciones del formulario de contacto
CONTACT_NOTIFICATION_EMAIL=info@magnaingenieriaytopografia.com

# --- Mapa (Leaflet) ----------------------------------------------------------
# Coordenadas del mapa de contacto. Fallback: ubicación actual de Magna
VITE_MAP_LAT=4.444319033924122
VITE_MAP_LNG=-75.23365217644438
VITE_MAP_ZOOM=17
